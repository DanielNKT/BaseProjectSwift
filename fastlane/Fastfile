default_platform(:ios)

platform :ios do
  ######################################################
  # Main lane: bump version, build, and upload to Firebase
  ######################################################
  desc "Increment version, build app, and upload to Firebase"
  lane :build do |options|
    bump = options[:bump] || "patch" # default: patch (can be major/minor/patch)
    increment_version(bump: bump)
    build_ios_dev
    firebase_app_distribution(
      app: "1:277886324138:ios:d11a030153e11ee26aefd3",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"], # keep token secret
      testers: "nktoan.dev@gmail.com",
      release_notes: "Test Fastlane iOS!!"
    )
  end

  ######################################################
  # Build only (no upload)
  ######################################################
  lane :build_ios_dev do 
    build_app(
      scheme: "BaseProjectSwift",
      workspace: "BaseProjectSwift.xcworkspace",
      include_bitcode: true,
      export_method: "development"
    )
  end

  ######################################################
  # Increment version number
  # - bumps marketing version (major/minor/patch)
  # - resets build number to 1
  ######################################################
  lane :increment_version do |options|
  bump = options[:bump] || "patch"

  begin
    version = get_version_number(
      xcodeproj: "BaseProjectSwift.xcodeproj"
    )
    UI.message("Current version: #{version}")
  rescue
    UI.important("⚠️ No valid version found, setting initial version to 1.0.0 (1)")
    increment_version_number(
      version_number: "1.0.0",
      xcodeproj: "BaseProjectSwift.xcodeproj"
    )
    increment_build_number(
      build_number: 1,
      xcodeproj: "BaseProjectSwift.xcodeproj"
    )
    next
  end

  # Bump the version (major/minor/patch)
  increment_version_number(
    bump_type: bump,
    xcodeproj: "BaseProjectSwift.xcodeproj"
  )

  # Reset build number back to 1
  increment_build_number(
    build_number: 1,
    xcodeproj: "BaseProjectSwift.xcodeproj"
  )
end


  ######################################################
  # Load ASC API Key for App Store Connect
  ######################################################
  desc "Load ASC API Key information to use in subsequent lanes"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
  end
end
